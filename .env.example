# Your bot token from @BotFather (required)
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Optional: restrict the bot to a single Telegram user id.
# Message @userinfobot to find your numeric id. Leave empty to allow anyone.
ALLOWED_USER_ID=

# Webhook mode (optional). Leave empty to use long-polling (works anywhere).
# Set to your public HTTPS base URL (no trailing slash) on hosts like Render/Fly.
# e.g. PUBLIC_URL=https://combo-cleaner-bot.onrender.com
PUBLIC_URL=

# Port for the health/webhook server. Hosts usually set this automatically.
PORT=8080