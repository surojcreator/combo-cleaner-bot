# Your bot token from @BotFather (required)
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Optional: restrict the bot to a single Telegram user id.
# Message @userinfobot to find your numeric id. Leave empty to allow anyone.
ALLOWED_USER_ID=

# Webhook mode (optional). Leave empty to use long-polling (works anywhere).
# Set to your public HTTPS base URL (no trailing slash) on hosts like Render/Fly.
# e.g. PUBLIC_URL=https://combo-cleaner-bot.onrender.com
PUBLIC_URL=

# Base URL for direct download links (optional).
# Defaults to PUBLIC_URL, RENDER_EXTERNAL_URL, or server IP:PORT if left blank.
DOWNLOAD_BASE_URL=

# Port for the health/webhook server. Hosts usually set this automatically.
PORT=8080

# --- ULP search relay (/ulp) -------------------------------------------------
# The searcher bot that receives the query + history request. Telegram only
# delivers private messages between bots when "Bot-to-Bot Communication" is
# enabled for BOTH bots in @BotFather (otherwise: USER_BOT_TO_BOT_DISABLED).
SEARCH_BOT_USERNAME=DumpNews14Bot

# Wait this long before *every* try (query, history request and each retry).
SEARCH_STEP_DELAY_MS=12000

# How long to wait for an answer before repeating the query + history pair.
SEARCH_RESULT_WAIT_MS=20000

# How many times the query + history pair may be repeated.
SEARCH_MAX_TRIES=3

# Template of the history request. {scope} is day | month | year.
SEARCH_HIST_TEMPLATE=hist:full:{scope}

# How long a run keeps relaying results before it closes itself.
SEARCH_WINDOW_MS=300000

# --- Account bypass for sealed search bots -----------------------------------
# Forces which path /ulp uses: auto (default), bot (Bot API only), or userbot
# (your own account over MTProto - works even when the searcher bot never
# enabled Bot-to-Bot Communication). Needs the three TELEGRAM_* settings below.
SEARCH_TRANSPORT=auto

# Create the app at https://my.telegram.org (api_id + api_hash), then run
# `npm run userbot:login` to print TELEGRAM_SESSION. Secrets - never commit.
#
# SECURITY NOTE: These are sensitive credentials. Never commit real values to
# version control. Use .env locally (it's gitignored) and your hosting platform's
# Secrets manager in production (Render, etc.).
#
# ⚠️  If these ever leak (e.g., pasted in chat, commit to a public repo):
#    1. Revoke/regenerate the api_hash at https://my.telegram.org
#    2. Recreate the session with `npm run userbot:login`
#    3. Update your secrets everywhere
TELEGRAM_API_ID=YOUR_API_ID_FROM_MY_TELEGRAM_ORG
TELEGRAM_API_HASH=YOUR_API_HASH_FROM_MY_TELEGRAM_ORG
TELEGRAM_SESSION=

# Local-disk processing. Uploaded files may be placed here by SCP/SFTP/etc.
# The MTProto `/save` command also downloads replied-to group documents here.
LOCAL_PROCESS_ROOT=/var/data
# Optional maximum compressed zip size accepted by /process. Zip handling is
# RAM-bound; plain text is streamed and does not use this limit. Default: 4 GiB.
PROCESS_MAX_ZIP_BYTES=4294967296
# Full cleaned output is written here, even after the in-memory batch reaches
# its cap. /lsearch searches the newest file in this directory.
LOCAL_PROCESSED_ROOT=/var/data/processed

# Memory capacity: Max cleaned lines retained in active memory per chat.
# Default: 10000000 (10 Million credentials). Set to 0 for unlimited (RAM bounded).
MAX_LINES_PER_CHAT=10000000
# Max concurrent chat batches tracked simultaneously in memory. Default: 500.
MAX_CHATS=500