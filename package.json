{
    "name": "telegram-combo-cleaner-bot",
    "version": "1.0.0",
    "private": true,
    "description": "Telegram bot that cleans forwarded .zip combolists down to email:password / number:password (dropping URL/domain lines) and can combine many cleaned files into one.",
    "main": "src/index.js",
    "scripts": {
        "start": "node src/index.js",
        "test": "node --test",
        "userbot:login": "node scripts/userbot-login.js",
        "userbot:login:noninteractive": "node scripts/userbot-login-noninteractive.js"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "adm-zip": "^0.5.16",
        "dotenv": "^16.4.7",
        "telegraf": "^4.16.3",
        "teleproto": "^1.229.0"
    }
}
